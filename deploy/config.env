# iDataSight deployment config — edit DOMAIN, leave the rest unless you know why.

# The subdomain you want the app served on. Must be a subdomain you control.
# Live demo domain. sslip.io is wildcard DNS — <ip>.sslip.io resolves to <ip>
# with no record to create, and Let's Encrypt still issues a real cert for it.
# To move to the GoDaddy domain once its A record saves: swap the two lines
# below and run ./deploy/deploy.sh (forces a frontend rebuild, ~4 min).
DOMAIN="54.71.45.186.sslip.io"
# DOMAIN="idatasight.consciouselectron.com"

# AWS
AWS_PROFILE="idatasight"
REGION="us-west-2"
INSTANCE_TYPE="t3.medium"     # 4 GB — t3.small OOMs during the bun frontend build
VOLUME_GB="20"
STACK="idatasight"            # name prefix for key pair / security group / instance

# App runtime
IDATASIGHT_DEMO="0"           # 0 = real engine, 1 = wireframe demo content
IDATASIGHT_SOURCE="csv"       # csv now; flip to "snowflake" via deploy/enable-snowflake.sh later

# Local paths
APP_DIR="/Users/cworks/PLATFORM/APPLICATIONS/iDataSight"
